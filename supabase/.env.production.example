# Copia a supabase/.env.production (archivo ignorado por Git) y sustituye los valores.
# APP_BASE_URL: URL pública completa hasta la raíz del sitio; incluye /<repositorio> en Pages de proyecto.
APP_BASE_URL=https://deividd11.github.io/REEMPLAZAR-POR-REPOSITORIO
# Secreto privado de Resend. Nunca lo pongas en appConfig.js ni en GitHub Pages.
RESEND_API_KEY=REEMPLAZAR_CON_API_KEY_DE_RESEND
# Remitente autorizado/verificado en Resend.
MAIL_FROM="Nexo <noreply@REEMPLAZAR-POR-DOMINIO-VERIFICADO>"
